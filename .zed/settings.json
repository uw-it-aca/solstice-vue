{
  // ignore eslint
  "language_servers": ["oxlint", "oxfmt"],
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          //"run": "onSave",
        },
      },
    },
  },
  // ... other settings
  "languages": {
    "CSS": {
      "formatter": { "language_server": { "name": "oxfmt" } },
      "format_on_save": "off",
    },
    "SCSS": {
      "formatter": { "language_server": { "name": "oxfmt" } },
      "format_on_save": "off",
    },
    "Vue.js": {
      "formatter": { "language_server": { "name": "oxfmt" } },
      "format_on_save": "off",
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "oxfmt" } },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "oxfmt" } },
    },
  },
}
